import collections
from datetime import datetime, timezone
import os
import sys
import threading
import time
import matplotlib.animation as animation
import matplotlib.pyplot as plt
import serial

# --- Configuração ---
SERIAL_PORT = "COM5"  # Atualiza com a tua porta COM ativa
BAUD_RATE = 921600
OUTPUT_DIR = r"C:\Users\Duarte Chambel\Desktop\KTH\Year1\P1\Tech and Health (Project Course)\Reaction-Time-System\data"
WINDOW_SECONDS = 3.0  # Janela visível no gráfico (segundos)
UPDATE_INTERVAL_MS = 50  # Intervalo de refresh do gráfico (50 ms = ~20 FPS)

# Taxa de amostragem definida no firmware Arduino (833 Hz)
SAMPLING_RATE_HZ = 833
MAX_SAMPLES = int(WINDOW_SECONDS * SAMPLING_RATE_HZ)

os.makedirs(OUTPUT_DIR, exist_ok=True)
file_timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
filename = os.path.join(OUTPUT_DIR, f"kinestart_imu_{file_timestamp}.csv")

# --- Ring Buffers para Streaming ---
t_data = collections.deque(maxlen=MAX_SAMPLES)
x_data = collections.deque(maxlen=MAX_SAMPLES)
y_data = collections.deque(maxlen=MAX_SAMPLES)
z_data = collections.deque(maxlen=MAX_SAMPLES)
mag_data = collections.deque(maxlen=MAX_SAMPLES)

data_lock = threading.Lock()
running = True


def serial_reader():
    """Lê continuamente os dados a 833 Hz da porta série e guarda no CSV."""
    global running
    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=0.5)
        # Limpa o lixo que possa estar na fila antes de começar
        ser.reset_input_buffer()
        time.sleep(0.1)
        # Comando para iniciar o stream no Arduino
        ser.write(b"r")
        print("Sinal 'r' enviado. Aquisição iniciada...")
    except Exception as e:
        print(f"Erro ao abrir {SERIAL_PORT}: {e}")
        running = False
        return

    with open(filename, "w", encoding="utf-8", buffering=8192) as f:
        f.write("timestamp_iso,elapsed_s,x_g,y_g,z_g\n")
        
        while running:
            try:
                raw_line = ser.readline().decode("utf-8", errors="ignore").strip()
                if not raw_line:
                    continue

                # Filtrar linhas que não correspondam a dados (ex: logs de inicialização, 'Stream stopped')
                parts = raw_line.split(",")
                if len(parts) == 4:
                    try:
                        elapsed_s = float(parts[0])
                        ax = float(parts[1])
                        ay = float(parts[2])
                        az = float(parts[3])
                    except ValueError:
                        continue  # Linha incompleta ou corrompida

                    mag = (ax**2 + ay**2 + az**2) ** 0.5
                    iso_ts = datetime.now(timezone.utc).isoformat()
                    f.write(f"{iso_ts},{raw_line}\n")

                    with data_lock:
                        t_data.append(elapsed_s)
                        x_data.append(ax)
                        y_data.append(ay)
                        z_data.append(az)
                        mag_data.append(mag)
                else:
                    # Imprime mensagens que não sejam dados diretamente (ex: logs de diagnóstico)
                    print(f"[Arduino]: {raw_line}")

            except serial.SerialException as e:
                print(f"Erro de leitura série: {e}")
                break

        # Envia sinal de paragem ao microcontrolador
        try:
            ser.write(b"s")
            time.sleep(0.05)
            ser.close()
            print("Sinal 's' enviado. Conexão terminada.")
        except Exception:
            pass


# Thread dedicada para leitura rápida da porta série
thread = threading.Thread(target=serial_reader, daemon=True)
thread.start()

# --- Configuração do Matplotlib ---
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 6), sharex=True)
fig.suptitle("IMU Data Stream (833 Hz via FIFO)", fontsize=12)

(line_x,) = ax1.plot([], [], "r-", label="X-Axis", lw=1)
(line_y,) = ax1.plot([], [], "g-", label="Y-Axis", lw=1)
(line_z,) = ax1.plot([], [], "b-", label="Z-Axis", lw=1)
ax1.set_ylabel("Accel [g]")
ax1.grid(True, linestyle="--", alpha=0.6)
ax1.legend(loc="upper right")

(line_mag,) = ax2.plot([], [], "m-", label="Magnitude |a|", lw=1.2)
ax2.set_xlabel("Elapsed Time [s]")
ax2.set_ylabel("Magnitude [g]")
ax2.grid(True, linestyle="--", alpha=0.6)
ax2.legend(loc="upper right")


def update(frame):
    """Atualização periódica dos gráficos."""
    with data_lock:
        if len(t_data) == 0:
            return line_x, line_y, line_z, line_mag

        t_list = list(t_data)
        x_list = list(x_data)
        y_list = list(y_data)
        z_list = list(z_data)
        mag_list = list(mag_data)

    line_x.set_data(t_list, x_list)
    line_y.set_data(t_list, y_list)
    line_z.set_data(t_list, z_list)
    line_mag.set_data(t_list, mag_list)

    # Janela temporal deslizante
    current_t = t_list[-1]
    min_t = max(0.0, current_t - WINDOW_SECONDS)
    ax1.set_xlim(min_t, max(min_t + WINDOW_SECONDS, current_t + 0.1))

    # Limites verticais dinâmicos
    all_accel = x_list + y_list + z_list
    if all_accel:
        ax1.set_ylim(min(all_accel) - 0.2, max(all_accel) + 0.2)
    if mag_list:
        ax2.set_ylim(min(mag_list) - 0.1, max(mag_list) + 0.2)

    return line_x, line_y, line_z, line_mag


ani = animation.FuncAnimation(
    fig,
    update,
    interval=UPDATE_INTERVAL_MS,
    blit=False,
    cache_frame_data=False,
)

plt.tight_layout()
try:
    plt.show()
finally:
    running = False
    thread.join(timeout=1.0)